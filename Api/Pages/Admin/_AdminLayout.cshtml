<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Panel Admina</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="bg-light">
@if (User.Identity?.IsAuthenticated ?? false)
{
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-page="/Admin/Index">Admin Panel</a>
            <div class="d-flex align-items-center text-white">
                <span class="me-3">Zalogowany jako: <strong>@User.Identity.Name</strong></span>
                <form method="post" asp-page="/Admin/Login" asp-page-handler="Logout" class="d-inline">
                    <button type="submit" class="btn btn-outline-light btn-sm">Wyloguj</button>
                </form>
            </div>
        </div>
    </nav>
}

<div class="container">
    @RenderBody()
</div>
</body>
</html>